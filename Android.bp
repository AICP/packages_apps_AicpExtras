package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

genrule {
    name: "aicp_extras_generate_ae_fragment_list",

    srcs: [
        "gather_search_fragments.sh",
        "AeFragmentList.java",
        "AndroidManifest.xml",
        "res/xml/**/*",
        "src/com/aicp/extras/fragments/**/*",
    ],

    out: [
        "src/com/aicp/extras/search/AeFragmentList.java",
    ],

    cmd: "$(location gather_search_fragments.sh) $(out) AndroidManifest.xml",
}

android_app {
    name: "AicpExtras",

    srcs: [
        "src/**/*.java",
        "src/**/*.kt",
        ":aicp_extras_generate_ae_fragment_list",
    ],

    manifest: "AndroidManifest.xml",

    resource_dirs: ["res"],

    asset_dirs: ["assets"],

    static_libs: [
        "androidx.core_core",
        "androidx.preference_preference",
        "androidx.appcompat_appcompat",
        "androidx.cardview_cardview",
        "androidx.recyclerview_recyclerview",
        "com.google.android.material_material",
        "SettingsLib",
        "AicpGear-preference",
        "AicpGear-util",
        "particles",
    "com.aicp.settings.resources",
        "colorpickerview",
        "androidx.palette_palette",
    ],

  libs: [
        "org.apache.http.legacy.stubs.system",
    ],

    uses_libs: [
        "org.apache.http.legacy",
    ],

    optional_uses_libs: [
        "androidx.window.extensions",
        "androidx.window.sidecar",
    ],

    privileged: true,
    system_ext_specific: true,
    certificate: "platform",
    platform_apis: true,

    required: ["privapp_whitelist_com.aicp.extras-ext.xml"],
    optimize: {
        enabled: false,
    },
}

prebuilt_etc {
    name: "privapp_whitelist_com.aicp.extras-ext.xml",
    src: "privapp_whitelist_com.aicp.extras-ext.xml",
    sub_dir: "permissions",
    system_ext_specific: true,
}

java_import {
    name: "particles",
    jars: ["lib/LeonidsLib-1.3.2.jar"],
}

android_library_import {
    name: "colorpickerview",
    aars: ["libs/colorpickerview-release.aar"],
}
