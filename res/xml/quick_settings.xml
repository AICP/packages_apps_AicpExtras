<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aicpextras="http://schemas.android.com/apk/res-auto"
    xmlns:settings="http://schemas.android.com/apk/res-auto"
    android:key="quick_settings"
    android:title="@string/quick_settings_title">

    <PreferenceCategory
        android:key="tile_layout_category"
        android:title="@string/qs_tile_layout_category_title">
        <com.aicp.gear.preference.SystemSettingIntListPreference
            android:key="qs_tile_shape"
            android:title="@string/qs_tile_animation_style_title"
            android:entries="@array/qs_tile_shape_entries"
            android:entryValues="@array/qs_tile_shape_values"
            android:summary="%s"
            android:defaultValue="0" />

        <com.aicp.gear.preference.SystemSettingSwitchPreference
            android:key="qs_bt_show_dialog"
            android:title="@string/qs_bt_show_dialog_title"
            android:summary="@string/qs_bt_show_dialog_summary"
            android:defaultValue="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="qs_layout_category"
        android:title="@string/qs_layout_category_title">

        <com.aicp.gear.preference.SystemSettingSliderPreference
            android:key="qs_tiles_columns"
            android:title="@string/qs_columns_portrait_title"
            android:max="6"
            android:min="2"
            aicpextras:interval="1"
            aicpextras:unitsLeft=""
            aicpextras:unitsRight=""
            android:defaultValue="4" />

        <com.aicp.gear.preference.SystemSettingSliderPreference
            android:key="qs_tiles_columns_landscape"
            android:title="@string/qs_columns_landscape_title"
            android:max="3"
            android:min="2"
            aicpextras:interval="1"
            aicpextras:unitsLeft=""
            aicpextras:unitsRight=""
            android:defaultValue="2" />

        <com.aicp.gear.preference.SystemSettingSliderPreference
            android:key="qs_tiles_rows"
            android:title="@string/qs_rows_portrait_title"
            android:max="5"
            android:min="2"
            aicpextras:interval="1"
            android:defaultValue="4" />

        <com.aicp.gear.preference.SystemSettingSliderPreference
            android:key="qs_tiles_rows_landscape"
            android:title="@string/qs_rows_landscape_title"
            android:max="3"
            android:min="1"
            aicpextras:interval="1"
            android:defaultValue="2" />

        <com.aicp.gear.preference.SystemSettingSliderPreference
            android:key="qqs_tiles_rows"
            android:title="@string/qqs_rows_portrait_title"
            android:max="3"
            android:min="1"
            aicpextras:interval="1"
            android:defaultValue="2" />

    </PreferenceCategory>
    <PreferenceCategory
        android:key="quick_settings_haptic_feedback_category"
        android:title="@string/quick_settings_haptic_feedback_category">

        <com.aicp.gear.preference.SystemSettingSwitchPreference
            android:key="qs_tile_haptic"
            android:title="@string/quick_settings_vibrate_title"
            android:summary="@string/quick_settings_vibrate_summary"
            android:defaultValue="false" />
    </PreferenceCategory>
    <PreferenceCategory
        android:title="@string/qs_brightness_slider_category">

        <com.aicp.gear.preference.SystemSettingIntListPreference
            android:key="qs_brightness_slider_shape"
            android:title="@string/qs_brightness_slider_shape_title"
            android:entries="@array/qs_brightness_slider_shape_entries"
            android:entryValues="@array/qs_brightness_slider_shape_values"
            android:defaultValue="0" />
    </PreferenceCategory>
    <PreferenceCategory
        android:key="qs_footer_category"
        android:title="@string/qs_footer_category_title">
        <com.aicp.gear.preference.SystemSettingSwitchPreference
            android:key="qs_footer_text_show"
            android:title="@string/footer_text_show_title"
            android:summary="@string/footer_text_show_summary"
            android:defaultValue="false" />

        <Preference
           android:key="custom_footer_text"
           android:title="@string/footer_text_label_title"
           android:dependency="qs_footer_text_show" />

        <com.aicp.gear.preference.SystemSettingSwitchPreference
            android:key="qs_footer_text_font_weight"
            android:title="@string/footer_text_font_weight_title"
            android:summary="@string/footer_text_font_weight_summary"
            android:defaultValue="false" />
	</PreferenceCategory>

     <PreferenceCategory
        android:key="qs_panel_bg_options"
        android:title="@string/qs_panel_opacity_category_title">
    
    <com.aicp.gear.preference.SecureSettingSwitchPreference
        android:key="pulse_qs_enabled"
        android:title="@string/pulse_qs_title"
        android:summary="@string/pulse_qs_summary"
        android:defaultValue="false" />

     </PreferenceCategory>
</PreferenceScreen>
