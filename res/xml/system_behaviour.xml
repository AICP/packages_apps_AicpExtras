<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:aicpextras="http://schemas.android.com/apk/res-auto"
    android:key="system_behaviour"
    android:title="@string/system_behaviour_title">

   <com.aicp.gear.preference.SecureSettingMasterSwitchPreference
        android:key="spoofing"
        android:title="@string/spoofing_title"
        android:summary="@string/spoofing_summary"
        android:fragment="com.aicp.extras.fragments.Spoofing"
        android:defaultValue="false" />

   <com.aicp.gear.preference.SystemSettingSwitchPreference
        android:key="enable_blurs_on_windows"
        android:title="@string/enable_blurs_on_windows_title"
        android:summary="@string/enable_blurs_on_windows_summary"
        android:defaultValue="true" />

   <com.aicp.gear.preference.SystemSettingSliderPreference
        android:key="background_blur_radius"
        android:title="@string/background_blur_radius_title"
        android:summary="@string/background_blur_radius_summary"
        android:max="175"
        android:min="5"
        android:defaultValue="34"
        android:dependency="enable_blurs_on_windows" />

    <com.aicp.gear.preference.SystemSettingSwitchPreference
        android:key="sensor_block"
        android:title="@string/sensor_block_title"
        android:summary="@string/sensor_block_summary"
        android:defaultValue="false"/>

    <com.aicp.gear.preference.SystemSettingSwitchPreference
        android:key="pocket_judge"
        android:title="@string/pocket_judge_title"
        android:summary="@string/pocket_judge_summary"
        android:defaultValue="false" />

    <com.aicp.gear.preference.SelfRemovingPreferenceCategory
        android:key="smart_pixels"
        android:title="@string/smart_pixels_title"
        aicpextras:requiresConfig="@*android:bool/config_supportSmartPixels">

        <com.aicp.gear.preference.SystemSettingMasterSwitchPreference
            android:key="smart_pixels_enable"
            android:title="@string/smart_pixels_title"
            android:summary="@string/smart_pixels_summary"
            android:defaultValue="false"
            android:fragment="com.aicp.extras.fragments.SmartPixels" />

    </com.aicp.gear.preference.SelfRemovingPreferenceCategory>

    <PreferenceCategory
        android:key="system_ss_category"
        android:title="@string/system_ss_category_title">
    </PreferenceCategory>

    <PreferenceCategory
        android:key="system_security_category"
        android:title="@string/system_security_category_title">

        <com.aicp.gear.preference.SecureSettingSwitchPreference
            android:key="window_ignore_secure"
            android:title="@string/ignore_window_secure_title"
            android:summary="@string/ignore_window_secure_summary"
            android:defaultValue="false"/>

        <com.aicp.gear.preference.GlobalSettingIntListPreference
            android:key="settings_reboot_after_timeout"
            android:title="@string/auto_reboot_title"
            android:summary="@string/auto_reboot_summary"
            android:entries="@array/reboot_after_timeout_entries"
            android:entryValues="@array/reboot_after_timeout_values"
            android:defaultValue="0" />

    </PreferenceCategory>
</PreferenceScreen>
